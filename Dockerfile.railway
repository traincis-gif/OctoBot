FROM python:3.13-slim-bullseye AS base

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        gcc \
        binutils \
        libffi-dev \
        libssl-dev \
        libxml2-dev \
        libxslt1-dev \
        libxslt-dev \
        libjpeg62-turbo-dev \
        libatlas-base-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CRYPTOGRAPHY_DONT_BUILD_RUST=1

# Cache bust: Railway may cache COPY layer. This ARG changes on every commit.
ARG CACHE_BUST=1
COPY . /build/

# Install all pip dependencies + Paradex bot package, then copy sub-packages
# into site-packages (they have no setup.py — Pants monorepo layout)
RUN python -m venv /opt/venv \
    && . /opt/venv/bin/activate \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -r full_requirements.txt \
    && for f in packages/*/requirements.txt; do pip install --no-cache-dir -r "$f"; done \
    && for f in packages/*/full_requirements.txt; do [ -f "$f" ] && pip install --no-cache-dir -r "$f"; done \
    && pip install --no-cache-dir . \
    && pip install --no-cache-dir fastapi uvicorn[standard] python-telegram-bot itsdangerous jinja2 python-multipart \
    && SITE=$(/opt/venv/bin/python -c "import site; print(site.getsitepackages()[0])") \
    && cp -r packages/commons/octobot_commons "$SITE/" \
    && cp -r packages/async_channel/async_channel "$SITE/" \
    && cp -r packages/trading/octobot_trading "$SITE/" \
    && cp -r packages/trading_backend/trading_backend "$SITE/" \
    && cp -r packages/backtesting/octobot_backtesting "$SITE/" \
    && cp -r packages/evaluators/octobot_evaluators "$SITE/" \
    && cp -r packages/tentacles_manager/octobot_tentacles_manager "$SITE/" \
    && cp -r packages/services/octobot_services "$SITE/" \
    && cp -r packages/node/octobot_node "$SITE/" \
    && mkdir -p "$SITE/tentacles" \
    && touch "$SITE/tentacles/__init__.py" \
    && for d in Trading Evaluator Meta Services Backtesting Automation profiles; do \
         [ -d "packages/tentacles/$d" ] && cp -r "packages/tentacles/$d" "$SITE/tentacles/"; \
       done \
    && find "$SITE/tentacles" -type d -exec sh -c 'touch "$1/__init__.py" 2>/dev/null; true' _ {} \; \
    && cp -r paradex_dashboard "$SITE/" \
    && cp -r paradex_telegram "$SITE/" \
    && cp paradex_launcher.py "$SITE/"

FROM python:3.13-slim-bullseye

WORKDIR /octobot

COPY --from=base /opt/venv /opt/venv
COPY octobot/config /octobot/octobot/config
COPY docker/* /octobot/

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libxslt-dev \
        libxcb-xinput0 \
        libjpeg62-turbo-dev \
        zlib1g-dev \
        libblas-dev \
        liblapack-dev \
        libatlas-base-dev \
        libopenjp2-7 \
        libtiff-dev \
    && rm -rf /var/lib/apt/lists/* \
    && chmod +x docker-entrypoint.sh \
    && chmod +x paradex-entrypoint.sh \
    && chmod +x tunnel.sh

ENV PATH="/opt/venv/bin:$PATH"

RUN useradd -m -u 1000 -s /bin/bash octobot \
    && mkdir -p /octobot/backtesting /octobot/logs /octobot/tentacles /octobot/user \
    && chown -R octobot:octobot /octobot

USER octobot

EXPOSE 8080

ENTRYPOINT ["./paradex-entrypoint.sh"]
